  <text x="192" y="138" style="fill:rgb(226, 75, 74);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Courier New&quot;, monospace;font-size:26px;font-weight:700;text-anchor:start;dominant-baseline:auto">{</text>
